# systemd --user unit template (install via `sense install-service` when implemented)
#
#   systemctl --user enable --now roxabi-sense.service
#
# Bind to graphical session so Wayland idle_watch + AT-SPI see WAYLAND_DISPLAY.
# After login, ensure session env is imported if needed:
#   systemctl --user import-environment WAYLAND_DISPLAY XDG_RUNTIME_DIR XDG_SESSION_TYPE

[Unit]
Description=roxabi-sense workstation attention journal
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/sense daemon
Restart=always
RestartSec=5
# Environment=SENSE_CONFIG=%h/.config/roxabi-sense/config.toml

[Install]
WantedBy=graphical-session.target
